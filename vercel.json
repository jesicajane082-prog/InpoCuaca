{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api|src|node_modules|@react-refresh|@vite|favicon.svg|assets|trading-db.json).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/trading-bot",
      "schedule": "*/5 * * * *"
    }
  ]
}
